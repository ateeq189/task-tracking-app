rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return signedIn() && userProfile(request.auth.uid).role == 'admin';
    }

    function validTask(data) {
      return data.keys().hasAll([
          'title',
          'description',
          'assignedTo',
          'assignedBy',
          'createdBy',
          'status',
          'priority',
          'dueDate',
          'createdAt',
          'completedAt'
        ])
        && data.keys().hasOnly([
          'title',
          'description',
          'assignedTo',
          'assignedBy',
          'createdBy',
          'status',
          'priority',
          'dueDate',
          'createdAt',
          'completedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.description is string
        && data.assignedTo is string
        && data.assignedBy is string
        && data.createdBy is string
        && data.status in ['pending', 'in_progress', 'completed']
        && data.priority in ['low', 'medium', 'high']
        && data.dueDate is timestamp
        && data.createdAt is timestamp
        && (data.completedAt == null || data.completedAt is timestamp);
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'name',
          'email',
          'role',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'email',
          'role',
          'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.role == 'intern'
        && request.resource.data.createdAt is timestamp;

      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin());
      allow update, delete: if false;
    }

    match /tasks/{taskId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.assignedTo == request.auth.uid);

      allow create: if validTask(request.resource.data)
        && (
          isAdmin()
          || (
            signedIn()
            && request.resource.data.assignedTo == request.auth.uid
            && request.resource.data.assignedBy == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.completedAt == null
          )
        );

      allow update: if validTask(request.resource.data)
        && (
          isAdmin()
          || (
            signedIn()
            && resource.data.assignedTo == request.auth.uid
            && request.resource.data.assignedTo == resource.data.assignedTo
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'completedAt'])
            && (
              (
                request.resource.data.status == 'completed'
                && request.resource.data.completedAt is timestamp
              )
              || (
                request.resource.data.status != 'completed'
                && request.resource.data.completedAt == null
              )
            )
          )
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.assignedTo == request.auth.uid
          && resource.data.assignedBy == request.auth.uid
        );
    }
  }
}
